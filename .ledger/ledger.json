{
 "goal": "Deliver a runnable, documented multi-rail agent-payment adapter (one PaymentRail interface; EVM/USDC and Nano/XNO rails) that a wallet-SDK maintainer can check and cite as a working example.",
 "repo": "/root/work/agent-wallet-multirail",
 "created": "2026-09-21T05:53:15+00:00",
 "base_commit": null,
 "ledger_id": "2d4ccb2964efc7df",
 "laws": [
  {
   "id": "L0",
   "block": 1.0,
   "statement": "NanoRail and UsdcRail both implement the same PaymentRail interface.",
   "test": "Both concrete rails subclass PaymentRail and expose pay, quote, name.",
   "scope": [
    "src/**"
   ],
   "oracle": "python3 -c \"import sys; sys.path.insert(0,'src'); from agent_wallet_multirail.rails import PaymentRail, NanoRail, UsdcRail; assert issubclass(NanoRail, PaymentRail) and issubclass(UsdcRail, PaymentRail); r=NanoRail(); assert callable(r.pay) and callable(r.quote) and isinstance(r.name,str); print('RAILS-OK')\"",
   "expect": "RAILS-OK",
   "source": null,
   "grounding": "oracle",
   "version": 1,
   "minted": "2026-09-21T05:53:50+00:00"
  },
  {
   "id": "L1",
   "block": 1.0,
   "statement": "NanoRail is feeless and sub-second while UsdcRail charges a fee",
   "test": "quote() returns fee 0 and fast finality for Nano, positive fee for USDC",
   "scope": [
    "src/**"
   ],
   "oracle": "python3 -c \"import sys; sys.path.insert(0,'src'); from agent_wallet_multirail.rails import NanoRail, UsdcRail; n=NanoRail().quote(1.0); u=UsdcRail().quote(1.0); assert n.fee_usd==0 and n.finality_s<1; assert u.fee_usd>0; print('FEES-OK')\"",
   "expect": "FEES-OK",
   "source": null,
   "grounding": "oracle",
   "version": 2,
   "minted": "2026-09-21T05:54:47+00:00"
  },
  {
   "id": "L2",
   "block": 2.1,
   "statement": "The example settles the same payment on any named rail via the shared helper",
   "test": "Running the example on a named rail prints that rail and a settled True result",
   "scope": [
    "examples/**"
   ],
   "oracle": "cd /root/work/agent-wallet-multirail && . .venv/bin/activate && { python3 examples/pay_on_any_rail.py usdc-evm 2>&1 && python3 examples/pay_on_any_rail.py 2>&1; } | grep -E 'rail  : usdc-evm|settled  : True'",
   "expect": "EX-OK",
   "source": null,
   "grounding": "oracle",
   "version": 3,
   "minted": "2026-09-21T06:01:05+00:00"
  },
  {
   "id": "L3",
   "block": 2.2,
   "statement": "The test suite covers both rails the dispatch and the rpc seam",
   "test": "Running pytest reports all tests passed",
   "scope": [
    "tests/**"
   ],
   "oracle": "cd /root/work/agent-wallet-multirail && . .venv/bin/activate && python -m pytest -q 2>&1 | grep -q 'passed' && echo TESTS-OK",
   "expect": "TESTS-OK",
   "source": null,
   "grounding": "oracle",
   "version": 2,
   "minted": "2026-09-21T06:01:36+00:00"
  }
 ],
